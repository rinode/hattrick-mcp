{
  "manifest_version": "0.3",
  "name": "hattrick",
  "display_name": "Hattrick",
  "version": "0.0.0",
  "description": "Read-only Hattrick CHPP data: your team, players, matches, training, economy and transfers",
  "author": {
    "name": "rinode",
    "email": "mail@vanmarino.nl"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rinode/hattrick-mcp"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "server/hattrick-mcp",
    "mcp_config": {
      "command": "${__dirname}/server/hattrick-mcp",
      "args": ["serve"],
      "env": {
        "HATTRICK_CONSUMER_KEY": "${user_config.consumer_key}",
        "HATTRICK_CONSUMER_SECRET": "${user_config.consumer_secret}"
      },
      "platform_overrides": {
        "win32": {
          "command": "${__dirname}/server/hattrick-mcp.exe"
        },
        "linux": {
          "command": "${__dirname}/server/hattrick-mcp-linux"
        }
      }
    }
  },
  "user_config": {
    "consumer_key": {
      "type": "string",
      "title": "CHPP consumer key",
      "description": "Consumer key of your approved CHPP product",
      "required": true,
      "sensitive": true
    },
    "consumer_secret": {
      "type": "string",
      "title": "CHPP consumer secret",
      "description": "Consumer secret of your approved CHPP product",
      "required": true,
      "sensitive": true
    }
  }
}
